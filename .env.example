# Optional: set business details without editing code. Inlined at BUILD time (rebuild after changing).
# Values can also be set directly in src/config/business.ts.

# Production domain, no trailing slash. Leaving this empty keeps the site noindex.
NEXT_PUBLIC_SITE_URL=

# International format, e.g. +919876543210
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_PHONE=

NEXT_PUBLIC_EMAIL=
