# Copy to .env.local for local work (git-ignored) and set the same names in your hosting provider.
# NEVER commit real values. NEXT_PUBLIC_* values are inlined at BUILD time (rebuild after changing them).

# --- Business details (optional overrides; defaults live in src/config/business.ts) ----------------
# Production domain, no trailing slash. Leaving this empty keeps the site noindex.
NEXT_PUBLIC_SITE_URL=

# International format, e.g. +919876543210
NEXT_PUBLIC_WHATSAPP=

NEXT_PUBLIC_PHONE=

NEXT_PUBLIC_EMAIL=

# --- Google Tag Manager (public identifier, not a secret) -----------------------------------------
# Defaults to the owner's container (src/config/business.ts). Set to override (e.g. a staging
# container) or to "off" to disable. GTM only loads in production builds that also have
# NEXT_PUBLIC_SITE_URL set, and never on /admin.


NEXT_PUBLIC_GTM_ID=


# --- Supabase blog (public, read-only) ------------------------------------------------------------
# Project URL and the *publishable* key (Supabase dashboard -> Project Settings -> API Keys).
# The publishable key is safe in the browser by design: it can only do what Row Level Security allows
# (read published posts). Do NOT put a secret / service_role key in any NEXT_PUBLIC_* variable.
# (A legacy project may call this the "anon" key; the same variable name is used for it.)

NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the blog is read from at build time: "supabase" (default) or "markdown" (content/blog/*.md —
# the documented rollback path). Rebuild after changing.

BLOG_SOURCE=supabase

# --- Admin / tooling only (NEVER NEXT_PUBLIC_, never set in the hosting provider) -------------------
# Used ONLY by `npm run db:migrate` and `npm run blog:import` on your own machine, to apply the SQL
# migration and import posts. The website itself never reads it.
# Use the *Session pooler* connection string (Dashboard -> Connect), because the direct
# db.<ref>.supabase.co host is IPv6-only. URL-encode special characters in the password (@ -> %40).
DATABASE_URL=
